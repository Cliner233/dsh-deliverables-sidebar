{
  "name": "@cliner/dsh-deliverables-sidebar",
  "version": "1.0.0",
  "private": true,
  "dependencies": { "zod": "4.6.6" },
  "type": "module",
  "description": "Conversation deliverables with chronological sorting in the right sidebar",
  "exports": { ".": "./index.js", "./client": "./client.js", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg" },
  "files": ["index.js", "model.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-sidebar-right", "@deepseek-ai/dsh-client-ui-session"] }
  }
}
